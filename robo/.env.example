# Copie este arquivo para "robo/.env" (sem o .example) e preencha com os valores reais.
# Esse arquivo nunca é enviado pro GitHub (já está no .gitignore) — fica só nesse computador.

# A mesma connection string do Postgres que já está configurada na Vercel
# (Project Settings -> Environment Variables -> POSTGRES_URL, na Vercel).
POSTGRES_URL=

# O mesmo valor de BOT_TOKEN que já está configurado na Vercel — precisa ser
# IDÊNTICO nos dois lados (Vercel e aqui).
BOT_TOKEN=

# Não precisa mexer, só existe uma paróquia usando o robô por enquanto.
PAROQUIA_ID=1
